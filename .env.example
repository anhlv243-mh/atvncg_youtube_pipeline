# Copy file này thành .env và điền giá trị thật — .env đã nằm trong .gitignore

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key

# Google Cloud / BigQuery
GCP_PROJECT_ID=your_gcp_project_id
BQ_DATASET=atvncg_youtube

# Đường dẫn key service account; bỏ trống nếu đã chạy `gcloud auth application-default login`
GOOGLE_APPLICATION_CREDENTIALS=key.json
